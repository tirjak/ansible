# RKE2 Server Configuration
# Generated by Ansible - Do not edit manually

# Server Token
token: {{ rke2_token }}

# Control plane binding and advertise on the same IP
bind-address: {{ rke2_control_plane_ip }}
advertise-address: {{ rke2_control_plane_ip }}

{% if rke2_server_config is defined and rke2_server_config.disable is defined %}
# Disabled components
disable:
{% for item in rke2_server_config.disable %}
  - {{ item }}
{% endfor %}
{% endif %}

{% if rke2_server_config is defined and rke2_server_config.etcd_arg is defined %}
# ETCD arguments
etcd-arg:
{% for arg in rke2_server_config.etcd_arg %}
  - {{ arg }}
{% endfor %}
{% endif %}

{% if rke2_server_config is defined and rke2_server_config.kubelet_arg is defined %}
# Kubelet arguments
kubelet-arg:
{% for arg in rke2_server_config.kubelet_arg %}
  - {{ arg }}
{% endfor %}
{% endif %}
write-kubeconfig-mode: "0644"
# Additional custom configuration
# cluster-cidr: 10.42.0.0/16
# service-cidr: 10.43.0.0/16
# cluster-dns: 10.43.0.10
