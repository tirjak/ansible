# RKE2 Agent Configuration
# Generated by Ansible - Do not edit manually

# Server URL
server: {{ rke2_server_url }}

# Agent Token
token: {{ rke2_token }}

{% if rke2_agent_config is defined and rke2_agent_config.kubelet_arg is defined %}
# Kubelet arguments
kubelet-arg:
{% for arg in rke2_agent_config.kubelet_arg %}
  - {{ arg }}
{% endfor %}
{% endif %}

# Additional custom configuration
# node-label:
#   - example=value
